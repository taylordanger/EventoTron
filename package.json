{
  "name": "eventotron",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/start-local.mjs",
    "start:node-only": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "node scripts/preflight-deploy.mjs && npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:check": "node scripts/preflight-deploy.mjs && npm run build && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "desktop:launch": "node scripts/desktop-launcher.mjs",
    "desktop:mac": "node scripts/build-macos-app.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types .wrangler/runtime.d.ts --config types/wrangler.jsonc --include-env false && tsc --noEmit --incremental false",
    "verify": "npm run lint -- --max-warnings 0 && npm run typecheck && npm test",
    "verify:browser": "node scripts/verify-browser.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "1.55.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
